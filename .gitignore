/target
**/*.rs.bk
Cargo.lock.orig

# difftest / ogeom-view build artifacts
/tools/difftest/target
/tools/ogeom-view/target

# `outside/` is its own workspace and so builds into its own target directory.
/outside/target

/docs/*.json.tmp

.DS_Store
*.swp

*.proptest-regressions

# The rendered book; `docs/book/src` is the source, this is build output.
/docs/book/book

# Scratch notes and captured tool output; never committed.
WARNS.txt

# Agent harness state. Only the skills are tracked.
/.claude/*
!/.claude/skills/

# Python bytecode from the tools/ scripts.
__pycache__/
